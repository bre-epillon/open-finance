# Copy to .env and fill in. .env is gitignored -- never commit a real key.

# Rotate this at https://fredaccount.stlouisfed.org/apikeys before first use;
# the key previously committed to open-finance is public and must be revoked.
FRED_API_KEY=

# QuestDB owned by the open-finance stack. From inside Docker the hostname is
# the compose service name; from a host shell it is localhost.
QUESTDB_HOST=questdb
QUESTDB_REST_PORT=9000
QUESTDB_ILP_PORT=9009
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=quest

# open-finance's API, used to register new tickers for backfill.
OPEN_FINANCE_API=http://financial_api:8000

# This project.
API_PORT=8100
FRONTEND_PORT=3100
