# open-finance environment. Copy to .env and fill in; .env is gitignored.
#
#     cp .env.example .env
#     git check-ignore .env      # must print ".env"
#
# Both docker compose (via env_file:) and the local non-Docker runs read this.
# For the local runs, source it before starting anything:
#
#     set -a; . ./.env; set +a
#
# NOTE: fred_worker now REFUSES TO START without FRED_API_KEY. That is
# deliberate -- it previously fell back to a committed key, so it would keep
# "succeeding" against a dead credential and silently stop updating the macro
# tables. A crash is the honest failure.

# --- secrets -------------------------------------------------------------
# Get a key at https://fredaccount.stlouisfed.org/apikeys
# The old key (05f6f0...) is in this repo's git history and on GitHub. Revoke
# it there before using a new one.
FRED_API_KEY=

# Optional. Raises the OpenFIGI rate limit used by transactions/parse_csv.py
# and (from Phase 3) the instrument search endpoint.
OPENFIGI_API_KEY=

# --- QuestDB -------------------------------------------------------------
# Host is "questdb" under docker compose, "localhost" for local runs.
QUESTDB_HOST=localhost
QUESTDB_REST_PORT=9000
QUESTDB_ILP_PORT=9009
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=quest

# --- corporate TLS interception -----------------------------------------
# Every Python process here needs these on the work machine. Point them at the
# corporate CA bundle. BACKLOG.md records this being re-typed by hand for every
# ad-hoc script; that is what this file is for.
# SSL_CERT_FILE=
# CURL_CA_BUNDLE=
# REQUESTS_CA_BUNDLE=
